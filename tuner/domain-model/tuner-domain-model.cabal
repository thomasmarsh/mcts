cabal-version:      3.0
name:               tuner-domain-model
version:            0.1.0.0
author:             Thomas Marsh
license-file:       LICENSE
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        MyLib,
        Identity,
        Effort,
        ConfigSpace,
        FamilyExclusions,
        Deployment,
        Statistics,
        Evaluation,
        Candidate,
        Evidence,
        Observations,
        Proposal,
        Tasks,
        Shadow,
        Elimination,
        Diagnostic,
        Racing,
        Allocation,
        Ranking,
        Artifacts,
        EventPayloads
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: GHC2024

executable tuner-domain-model
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        tuner-domain-model
    hs-source-dirs:   app
    default-language: GHC2024

test-suite tuner-domain-model-test
    import:           warnings
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        tuner-domain-model