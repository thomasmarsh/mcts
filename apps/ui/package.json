{
  "name": "mcts-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/src/ packages/*/src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcts/bench": "workspace:*",
    "@mcts/core": "workspace:*",
    "@mcts/game": "workspace:*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
